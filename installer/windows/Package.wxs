<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="SneeAI Agent"
      Manufacturer="SneeAI"
      Version="$(AgentVersion)"
      UpgradeCode="D3163531-9CB9-4BB1-AED7-779267B37E84"
      Language="1033"
      Scope="perUser"
      InstallerVersion="500">
    <SummaryInformation Description="SneeAI local Agent" Manufacturer="SneeAI" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of SneeAI Agent is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDirectory" Name="Programs">
        <Directory Id="SneeAIProductDirectory" Name="SneeAI">
          <Directory Id="INSTALLFOLDER" Name="Agent" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="SneeAI Agent" Level="1">
      <Files Include="$(PayloadDir)\**" Directory="INSTALLFOLDER" />
      <ComponentRef Id="LauncherComponent" />
    </Feature>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="LauncherComponent" Guid="*">
        <File Id="LauncherExe" Source="$(LauncherPath)" Name="sneeai-agent-launcher.exe" />
        <RegistryValue
            Root="HKCU"
            Key="Software\Microsoft\Windows\CurrentVersion\Run"
            Name="SneeAIAgent"
            Value="&quot;[#LauncherExe]&quot;"
            Type="string"
            KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <CustomAction
        Id="StopRunningAgent"
        FileRef="LauncherExe"
        ExeCommand="--stop"
        Execute="immediate"
        Impersonate="yes"
        Return="ignore" />
    <CustomAction
        Id="StartInstalledAgent"
        FileRef="LauncherExe"
        ExeCommand=""
        Execute="immediate"
        Impersonate="yes"
        Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="StopRunningAgent" Before="InstallFiles" Condition="Installed OR WIX_UPGRADE_DETECTED" />
      <Custom Action="StartInstalledAgent" After="InstallFiles" Condition="NOT (REMOVE = &quot;ALL&quot;)" />
    </InstallExecuteSequence>
  </Package>
</Wix>
